{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=127.0.0.1;Port=5432;Database=identity_dev;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "https://identity.local",
    "Audience": "https://identity.local/api",
    "KeyId": "local-dev-key-1",
    "SigningKeyPath": "/secrets/signing-key.pem",
    "AccessTokenLifetime": "00:10:00",
    "ClockSkew": "00:00:30"
  },
  "Session": {
    "RememberMeAbsoluteLifetime": "30.00:00:00",
    "DefaultAbsoluteLifetime": "1.00:00:00",
    "RememberMeIdleLifetime": "7.00:00:00",
    "DefaultIdleLifetime": "08:00:00",
    "MaxActiveSessionsPerUser": 10,
    "RefreshGraceWindow": "00:00:10",
    "HybridCacheTtl": "00:00:15"
  },
  "Security": {
    "Pbkdf2Iterations": 210000,
    "MaxFailedAccessAttempts": 5,
    "DefaultLockoutTimeSpan": "00:15:00",
    "BreachedPasswordCheckEnabled": false,
    "AuthenticatorIssuer": "IdentityFullstack"
  },
  "Seed": {
    "Enabled": true,
    "DemoUsers": true,
    "AllowDemoInProduction": false
  },
  "Smtp": {
    "Host": "mailpit",
    "Port": 1025,
    "FromEmail": "noreply@identity.local",
    "FromName": "Identity Fullstack Security",
    "UseSsl": false
  },
  "Forwarded": {
    "TrustedNetworks": "172.16.0.0/12,127.0.0.1,::1"
  },
  "Database": {
    "Migrate": true
  }
}
