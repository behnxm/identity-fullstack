# ==============================================================================
# Identity Fullstack Reference Architecture - Environment Configuration
# Generate your active local environment file with: ./scripts/init.sh
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=identity
POSTGRES_USER=identity_app
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_PORT=5432

# Database Connection String for ASP.NET Core API
ConnectionStrings__Database=Host=postgres;Port=5432;Database=identity;Username=identity_app;Password=replace_with_strong_random_db_password

# JWT & ECDSA P-256 Signing Key Configuration
# In production, keys are mounted as read-only secrets or retrieved from a Key Vault.
Jwt__Issuer=https://identity.local
Jwt__Audience=https://identity.local/api
Jwt__KeyId=local-dev-key-1
Jwt__SigningKeyPath=/secrets/signing-key.pem
# Alternatively, inline PEM format if file mounting is not supported:
# Jwt__PrivateKeyPem=""

# Demo Seeding Credentials (Only seeded when Seed:DemoUsers is true)
Seed__Enabled=true
Seed__DemoUsers=true
Seed__AllowDemoInProduction=false
SEED_DEMO_PASSWORD=replace_with_strong_random_demo_password

# Network Trust Boundaries & Forwarded Headers
# The API accepts client IP and user agent headers ONLY from trusted reverse proxies / BFF network.
Forwarded__TrustedNetworks=172.16.0.0/12,127.0.0.1,::1

# Mail Configuration (Mailpit for local dev/testing)
Smtp__Host=mailpit
Smtp__Port=1025
Smtp__FromEmail=noreply@identity.local
Smtp__FromName=Identity Fullstack Security

# Web / Nuxt BFF Configuration
NUXT_SESSION_PASSWORD=replace_with_at_least_32_characters_session_seal_secret
NUXT_API_BASE_URL=http://api:8080
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_TRUST_PROXY=true
